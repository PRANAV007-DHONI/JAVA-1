#include <stdio.h>

void encryptCaesar(char* text, int shift) {
    char ch;
    for (int i = 0; text[i] != '\0'; ++i) {
        ch = text[i];
        if (ch >= 'a' && ch <= 'z') {
            ch = (ch - 'a' + shift) % 26 + 'a';
        } else if (ch >= 'A' && ch <= 'Z') {
            ch = (ch - 'A' + shift) % 26 + 'A';
        }
        text[i] = ch;
    }
}

int main() {
    char message[] = "Hello GitHub";
    int shift = 4;
    
    encryptCaesar(message, shift);
    printf("Encrypted: %s\n", message);
    return 0;
}
