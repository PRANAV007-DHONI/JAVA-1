#include <stdio.h>

int main() {
    int ip1, ip2, ip3, ip4;
    char remains;
    char ipStr[50];

    printf("Enter IP address (e.g. 192.168.1.1): ");
    scanf("%s", ipStr);

    if (sscanf(ipStr, "%d.%d.%d.%d%c", &ip1, &ip2, &ip3, &ip4, &remains) == 4) {
        if ((ip1 >= 0 && ip1 <= 255) && (ip2 >= 0 && ip2 <= 255) &&
            (ip3 >= 0 && ip3 <= 255) && (ip4 >= 0 && ip4 <= 255)) {
            printf("Valid IPv4 Address\n");
            return 0;
        }
    }
    printf("Invalid IP Address\n");
    return 0;
}
